/**
 * @file version.hpp
 *
 * @brief  Provides an API for retrieving version information
 *         the currently active GDBus++ version and API level
 */

#pragma once

#include <cstdint>
#include <string>

#define GDBUSPP_API_VERSION @GDBUSPP_API_VERSION@

namespace GDBusPP {

/**
 *  Retrieve the runtime version of the GDBus++ library
 *
 * @return std::string
 */
std::string GetVersion();

uint16_t GetAPIversion();

} // namespace GDBusPP
